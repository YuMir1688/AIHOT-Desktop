<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AIHOT.Desktop</AssemblyName>
    <Version>1.2.0</Version>
    <Authors>YuMir</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;release/**;review-build/**</DefaultItemExcludes>
</PropertyGroup>
  <ItemGroup><PackageReference Include="QRCoder" Version="1.8.0" /></ItemGroup>
</Project>
