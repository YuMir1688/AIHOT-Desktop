<Window x:Class="AiHot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AIHOT · YuMir" Width="960" Height="66" MinWidth="560" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True" FontFamily="Microsoft YaHei UI">
 <Border x:Name="Shell" BorderThickness="1" CornerRadius="15" Padding="17,9">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource ThemeColorFA1C2D38}" Offset="0"/><GradientStop Color="{DynamicResource ThemeColorFA101823}" Offset="0.45"/><GradientStop Color="{DynamicResource ThemeColorFA172330}" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource ThemeColor64738C94}" Offset="0"/><GradientStop Color="{DynamicResource ThemeColor353E5063}" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
   <Grid x:Name="Grip" Background="Transparent" Cursor="SizeAll" ToolTip="任意非按钮区域均可拖动 · Alt + 拖动任意位置">
    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="104"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ThemeBrush73E5C1}" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="A" Foreground="{DynamicResource ThemeBrush133A30}" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="AI HOT" FontWeight="SemiBold" FontSize="15" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ThemeBrushEDF7F4}"/><TextBlock x:Name="Status" Text="YuMir" Foreground="{DynamicResource ThemeBrush8EA6AD}" FontSize="10" LineHeight="13" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <Border Grid.Column="2" Width="1" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ThemeBrush344656}"/>
   </Grid>
   <Grid Grid.Column="1" Margin="7,0,18,0" Height="40" VerticalAlignment="Center" x:Name="TickerArea" Background="Transparent" ClipToBounds="True" Cursor="Hand" ToolTip="点击打开原文 · 悬停暂停 · 拖动移动">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="16"/></Grid.RowDefinitions>
    <Canvas x:Name="Track" Height="24" ClipToBounds="True"><TextBlock x:Name="Headline" Text="正在获取 AI HOT 精选资讯" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource ThemeBrushEDF3FA}" TextWrapping="NoWrap"><TextBlock.RenderTransform><TranslateTransform x:Name="Shift"/></TextBlock.RenderTransform></TextBlock></Canvas>
    <TextBlock Grid.Row="1" x:Name="Subtitle" Text="值得关注的动态 · 正在抵达" Foreground="{DynamicResource ThemeBrush8A9CB0}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="AlignmentMenuButton" Width="32" Height="34" Padding="0" Background="Transparent" ToolTip="桌面对齐"><StackPanel Orientation="Horizontal"><Ellipse Width="3" Height="3" Fill="{DynamicResource ThemeBrush92A7B9}" Margin="2"/><Ellipse Width="3" Height="3" Fill="{DynamicResource ThemeBrush92A7B9}" Margin="2"/><Ellipse Width="3" Height="3" Fill="{DynamicResource ThemeBrush92A7B9}" Margin="2"/></StackPanel></Button>
    <Button x:Name="LockButton" Width="30" Height="34" Padding="0" Margin="3,0,0,0" Background="Transparent" ToolTip="锁定位置，防止误拖"><TextBlock x:Name="LockGlyph" FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE785;" Foreground="{DynamicResource ThemeBrush92A7B9}"/></Button>
   </StackPanel>
  </Grid>
 </Border>
</Window>
